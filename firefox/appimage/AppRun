#!/bin/sh
# 云·终末地 · AppImage 入口
# 真正的启动逻辑统一放在 scripts/launch-firefox.sh，仓库直跑与 AppImage 共用同一份代码。
set -u

APPDIR="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
HERE="$APPDIR/usr/share/endfield-firefox"

case "${1:-}" in
  --help|-h)
    cat <<'EOF'
云·终末地 · Firefox 外壳（AppImage）

用法:
  EndfieldCloudFirefox.AppImage [--url=URL] [--window-size=WxH]
                                [--fullscreen|--windowed]
                                [--window-mode=auto|fullscreen|windowed]

环境变量:
  ENDFIELD_FIREFOX_BACKEND=wayland|x11   强制渲染后端
  ENDFIELD_TAB_GUARD=0                   关闭标签页守护（同时不开 Marionette 端口）
  ENDFIELD_MARIONETTE_PORT=2828          守护连接的端口
  ENDFIELD_LOG=1                         保留启动日志
  DRY_RUN=1                              只打印最终命令，不启动

前提: Flatpak org.mozilla.firefox，且 devices=all（手柄可见）。
EOF
    exit 0
    ;;
  --version)
    echo "云·终末地 · Firefox 外壳（AppImage 启动器）"
    exit 0
    ;;
esac

if [ ! -f "$HERE/profile/user.js" ] || [ ! -x "$HERE/launch-firefox.sh" ]; then
  echo "[endfield-appimage] 包不完整: $HERE" >&2
  exit 3
fi

# AppImage 挂载点是只读的：把内置 profile 与守护脚本的位置告诉共用启动器，
# 由它把 profile 复制到 Flatpak 可写目录后再启动 Firefox。
ENDFIELD_FIREFOX_PROFILE_DIR="$HERE/profile"
ENDFIELD_FIREFOX_RUNTIME_PROFILE="$HOME/.var/app/org.mozilla.firefox/endfield-cloud/profile"
ENDFIELD_FIREFOX_FORCE_PROFILE_SYNC=1
ENDFIELD_LOG="${ENDFIELD_LOG:-1}"
ENDFIELD_GUARD_SCRIPT="$HERE/tab-guard.py"
export ENDFIELD_FIREFOX_PROFILE_DIR ENDFIELD_FIREFOX_RUNTIME_PROFILE \
       ENDFIELD_FIREFOX_FORCE_PROFILE_SYNC ENDFIELD_LOG ENDFIELD_GUARD_SCRIPT

exec "$HERE/launch-firefox.sh" "$@"
